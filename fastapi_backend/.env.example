# ===================================
# AutoPM Backend Configuration
# ===================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Application Settings
APP_NAME=AutoPM - Automotive Project Management Assistant
DEBUG=True
API_VERSION=v1

# Database Configuration
# SQLite database file (will be created automatically)
# Format: sqlite:///./database_filename.db
DATABASE_URL=sqlite:///./autopm.db

# JWT Authentication
# Generate a secure random secret key (e.g., using: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Encryption Key for OAuth Tokens
# Generate using Python: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
ENCRYPTION_KEY=your-32-byte-url-safe-base64-encoded-encryption-key

# GitHub OAuth2 Configuration
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Set Authorization callback URL to: http://localhost:5173/callback/github (or your frontend URL)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5173/callback/github

# Jira OAuth2 Configuration
# Create a Jira OAuth 2.0 app at: https://developer.atlassian.com/console/myapps/
# Set Callback URL to: http://localhost:5173/callback/jira (or your frontend URL)
JIRA_CLIENT_ID=your_jira_client_id
JIRA_CLIENT_SECRET=your_jira_client_secret
JIRA_REDIRECT_URI=http://localhost:5173/callback/jira

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ===================================
# Fake Data Generator Configuration - Multi-User Setup
# ===================================
# For generating realistic collaborative test data to GitHub and Jira
# See MULTI_USER_SETUP_GUIDE.md for detailed setup instructions

# Manager Account (without numbers) - Owns all repos and Jira projects
# Generate Personal Access Token at: https://github.com/settings/tokens
# Required scopes: repo, user, project, delete_repo
GITHUB_TOKEN=ghp_manager_github_personal_access_token_here
GITHUB_USERNAME=manager_github_username

# Manager Jira Configuration
# Generate API Token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=manager-email@example.com
JIRA_API_TOKEN=manager_jira_api_token_here

