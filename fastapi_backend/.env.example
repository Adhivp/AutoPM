# ===================================
# AutoPM Backend Configuration
# ===================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Application Settings
APP_NAME=AutoPM - Automotive Project Management Assistant
DEBUG=True
API_VERSION=v1

# Database Configuration
# SQLite database file (will be created automatically)
# Format: sqlite:///./database_filename.db
DATABASE_URL=sqlite:///./autopm.db

# JWT Authentication
# Generate a secure random secret key (e.g., using: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Encryption Key for OAuth Tokens
# Generate using Python: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
ENCRYPTION_KEY=your-32-byte-url-safe-base64-encoded-encryption-key

# GitHub OAuth2 Configuration
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Set Authorization callback URL to: http://localhost:5173/callback/github (or your frontend URL)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5173/callback/github

# Jira OAuth2 Configuration
# Create a Jira OAuth 2.0 app at: https://developer.atlassian.com/console/myapps/
# Set Callback URL to: http://localhost:5173/callback/jira (or your frontend URL)
JIRA_CLIENT_ID=your_jira_client_id
JIRA_CLIENT_SECRET=your_jira_client_secret
JIRA_REDIRECT_URI=http://localhost:5173/callback/jira

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ===================================
# Instructions for Setup:
# ===================================

# 1. Database Setup:
#    SQLite database file will be created automatically on first run.
#    No manual database setup required!

# 2. Generate JWT_SECRET:
#    openssl rand -hex 32

# 3. Generate ENCRYPTION_KEY:
#    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# 4. Install dependencies:
#    pip install sqlalchemy uvicorn fastapi pydantic-settings python-jose passlib bcrypt cryptography httpx python-dotenv python-multipart

# 5. Set up GitHub OAuth:
#    - Go to https://github.com/settings/developers
#    - Click "New OAuth App"
#    - Application name: AutoPM
#    - Homepage URL: http://localhost:5173
#    - Authorization callback URL: http://localhost:5173/callback/github
#    - Copy Client ID and Client Secret

# 6. Set up Jira OAuth:
#    - Go to https://developer.atlassian.com/console/myapps/
#    - Create a new OAuth 2.0 app
#    - Add callback URL: http://localhost:5173/callback/jira
#    - Configure permissions: read:jira-user, read:jira-work, write:jira-work
#    - Copy Client ID and Client Secret

# 7. Run the application:
#    uvicorn main:app --reload
